# gilda-outreach — environment template. Copy to .env and fill real values there.
# (File is named `env.example`, no leading dot, so it is safe to commit; the real
# .env is gitignored.) The product bot's secrets are NOT shared here — this
# service is deliberately isolated (see docs/OUTREACH-SENDER-SPEC.md §2).

# ── Service ───────────────────────────────────────────────────────────────
TZ=America/Mexico_City
PORT=8087                       # localhost only; reverse-proxied later if needed
BIND_HOST=127.0.0.1             # do NOT expose; mc-prometheus scrapes loopback
DB_PATH=./data/outreach.db
SESSIONS_DIR=./data/sessions    # Baileys creds (chmod 700 at startup)

# ── Outreach number (REQUIRED at P1) ──────────────────────────────────────
# The dedicated outreach SIM's FULL international number, digits only (no +).
# Used to request the WhatsApp pairing code at link time. Kept in .env, NEVER in
# committed source. This is a SEPARATE, dedicated line — not the personal line
# and not the product/bot line (5640501088, which is blocked below).
# OUTREACH_NUMBER=5215512345678

# ── Admin surface (REQUIRED at P1) ────────────────────────────────────────
# Gates /metrics + /health/session (the plain /health probe stays public).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_TOKEN=<generate a long random token, ≥16 chars>

# ── Global kill switch ────────────────────────────────────────────────────
# Default OFF. No message is ever sent while this is false (and no sender even
# exists until P3). Flip to 'true' only after the SIM is linked (P1) + warmed (P5).
OUTREACH_ENABLED=false

# ── No-outreach blocklist ─────────────────────────────────────────────────
# Numbers that must NEVER be messaged, rejected at import (prefix-agnostic, by
# 10-digit tail). The product/bot line 5640501088 is ALWAYS blocked by default
# in code. Add the operator's PERSONAL line (and any others) HERE — it is
# deliberately kept out of committed source. Comma-separated, 10-digit each:
# OUTREACH_BLOCKLIST=5500000000          # <- your personal line (set in .env, not here)

# ── Operator alerts (optional; off-number) ────────────────────────────────
# Interested-lead + session-halted alerts ALWAYS log to journald. If BOTH of
# these are set, they ALSO push to Telegram (open-decision #3 — confirm before
# warming). Leave unset to use journald only.
# OUTREACH_ALERT_TELEGRAM_BOT_TOKEN=
# OUTREACH_ALERT_TELEGRAM_CHAT_ID=

# ── Liveness watchdog (optional tuning) ───────────────────────────────────
# Recovers a stuck TRANSIENT socket; a logged_out/401 is a probable ban and is
# NEVER auto-reconnected (manual re-link only). Ban-averse defaults: 5 min stuck,
# 3 strikes then HALT + alert. Disable entirely with OUTREACH_WATCHDOG_ENABLED=false.
# OUTREACH_WATCHDOG_ENABLED=true
# OUTREACH_RECONNECT_STUCK_MINUTES=5
# OUTREACH_RECONNECT_MAX_STRIKES=3
# OUTREACH_DISCONNECT_ALERT_HOURS=24

# ── Google Sheets import (P0, operator-run) ───────────────────────────────
# The import script reads the validated-prospects sheet read-only. Credentials
# are sourced from mission-control's .env at run time, NOT stored here:
#   env $(grep -E 'GOOGLE_CLIENT_ID|GOOGLE_CLIENT_SECRET|GOOGLE_REFRESH_TOKEN' \
#     /root/claude/mission-control/.env | xargs) npm run import-prospects
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
PROSPECTS_SHEET_ID=1o3jjUyGIlpvlB1waINnUs7nFeBR3k3fworPH_xF550Y
PROSPECTS_SHEET_NAME=Sheet1
