# gilda-outreach — environment template. Copy to .env and fill real values there.
# (File is named `env.example`, no leading dot, so it is safe to commit; the real
# .env is gitignored.) The product bot's secrets are NOT shared here — this
# service is deliberately isolated (see docs/OUTREACH-SENDER-SPEC.md §2).

# ── Service ───────────────────────────────────────────────────────────────
TZ=America/Mexico_City
PORT=8087                       # localhost only; reverse-proxied later if needed
DB_PATH=./data/outreach.db

# ── Global kill switch ────────────────────────────────────────────────────
# Default OFF. No message is ever sent while this is false. Flip to 'true' only
# after the SIM is linked (P1) and warmed (P5). P0 ships with this OFF.
OUTREACH_ENABLED=false

# ── Admin surface (P4) ────────────────────────────────────────────────────
# ADMIN_TOKEN=<generate a long random token>

# ── Google Sheets import (P0, operator-run) ───────────────────────────────
# The import script reads the validated-prospects sheet read-only. Credentials
# are sourced from mission-control's .env at run time, NOT stored here:
#   env $(grep -E 'GOOGLE_CLIENT_ID|GOOGLE_CLIENT_SECRET|GOOGLE_REFRESH_TOKEN' \
#     /root/claude/mission-control/.env | xargs) npm run import-prospects
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
PROSPECTS_SHEET_ID=1o3jjUyGIlpvlB1waINnUs7nFeBR3k3fworPH_xF550Y
PROSPECTS_SHEET_NAME=Sheet1
